# local docker-compose settings: copy to .env (gitignored) and fill in.
#   cp .env.example .env
#   sed -i '' "s/^ENTG_DB_PASSWORD=.*/ENTG_DB_PASSWORD=$(openssl rand -hex 24)/" .env
#   sed -i '' "s/^ENTG_CLIENT_P12_PASSWORD=.*/ENTG_CLIENT_P12_PASSWORD=$(openssl rand -hex 16)/" .env
#
# never commit .env -- it holds the database password.

# postgres password for the "entanglement" role. used by the postgres container
# (only when the pg-data volume is first created), and spliced into the server's
# config.toml by docker/entrypoint.sh. letters, digits and . _ ~ - only.
ENTG_DB_PASSWORD=

# export password for docker/dev-certs/client.p12, the client cert bundle you
# import into your browser/keychain. changing it: update this, delete
# docker/dev-certs/client.p12, run `docker compose up certgen`.
ENTG_CLIENT_P12_PASSWORD=

# host port for the entanglement server (UI at /entanglement/app, API at
# /entanglement/api). always bound to 127.0.0.1 -- only the port is configurable.
# default 8444 avoids 8443, which other local dev stacks commonly use.
ENTG_HTTPS_PORT=8444

# host port for postgres, for GUI clients like pgAdmin (also loopback-only).
# connect with sslmode=require, user entanglement, database entanglement, and
# the ENTG_DB_PASSWORD above.
ENTG_DB_PORT=55433
