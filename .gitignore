# Generated by Cargo
# will have compiled files and executables
/target/
/webapp/dist/
/webapp/static/
/webapp/.dioxus/

# These are backup files generated by rustfmt
**/*.rs.bk

/dev/

.DS_STORE

# local docker-compose dev stack: host folder of test photos/video, bind-mounted
# read-only into the server container as media_srcdir
/media-src/*
!/media-src/.gitkeep

# generated dev CA/server/client TLS material -- regenerated by docker compose's
# certgen service on first `up`, never trusted material
/docker/dev-certs/
